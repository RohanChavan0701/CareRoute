  "schedule_amendment_requests": {
    "description": "Schedule amendments that Voice Agent can send back to orchestrator",
    "flight_change_amendment": {
      "jsonrpc": "2.0",
      "id": "amend_001",
      "method": "SubmitScheduleAmendment",
      "params": {
        "patient_id": "P001",
        "amendment_type": "flight_change",
        "reason": "flight_delay",
        "amendment_data": {
          "amendment_type": "flight_change",
          "reason": "flight_delay",
          "new_flight_data": {
            "flight_number": "WN123",
            "status": "DELAYED",
            "delay_minutes": 120,
            "estimated_arrival_local": "2025-10-12T14:00:00"
          },
          "additional_requests": ["hotel_checkout_extension"],
          "impact_assessment": "Hospital appointment may need rescheduling"
        }
      }
    },
    "hotel_change_amendment": {
      "jsonrpc": "2.0",
      "id": "amend_002",
      "method": "SubmitScheduleAmendment",
      "params": {
        "patient_id": "P001",
        "amendment_type": "hotel_change",
        "reason": "accessibility_upgrade",
        "amendment_data": {
          "amendment_type": "hotel_change",
          "reason": "accessibility_upgrade",
