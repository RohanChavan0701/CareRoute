# HIPAA-Compliant Database Configuration for Guardian Orchestrator
# Copy this file to .env and configure with your actual values

# Database Configuration
DATABASE_URL=postgresql://guardian_user:your_secure_password@localhost:5432/guardian_hipaa_db
# Example for AWS RDS: postgresql://username:password@your-rds-endpoint:5432/guardian_db

# HIPAA Encryption Configuration
HIPAA_ENCRYPTION_PASSWORD=your_very_secure_encryption_password_here_minimum_32_chars
HIPAA_ENCRYPTION_SALT=guardian_hipaa_salt_2024_secure_random_string

# Security Configuration
SECRET_KEY=your_secret_key_for_jwt_tokens_minimum_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Firebase Cloud Messaging (FCM)
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=path/to/your/firebase-service-account-key.json

# External API Endpoints
FLIGHT_AGENT_URL=http://54.158.27.0:8001/a2a
VOICE_AGENT_URL=http://18.217.151.15:8000/jsonrpc
NOTIFICATION_AGENT_URL=https://notification-system-h36d.onrender.com/a2a
HOTEL_AGENT_URL=http://your-hotel-agent-url/a2a
HOSPITAL_AGENT_URL=http://your-hospital-agent-url/a2a

# Security Headers
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
ALLOWED_HOSTS=["localhost", "127.0.0.1", "your-production-domain.com"]

# Logging Configuration
LOG_LEVEL=INFO
AUDIT_LOG_RETENTION_DAYS=2555  # 7 years for HIPAA compliance

# Performance Configuration
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=3600

# HIPAA Compliance Settings
ENABLE_AUDIT_LOGGING=true
ENABLE_ROW_LEVEL_SECURITY=true
ENABLE_DATA_ENCRYPTION=true
ENABLE_ACCESS_CONTROLS=true

# Backup Configuration
BACKUP_ENCRYPTION_KEY=your_backup_encryption_key_here
BACKUP_RETENTION_DAYS=2555  # 7 years

# Monitoring and Alerting
ENABLE_HEALTH_CHECKS=true
HEALTH_CHECK_INTERVAL=60
ALERT_EMAIL=admin@your-domain.com
