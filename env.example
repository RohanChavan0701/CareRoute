# Guardian A2A Orchestrator Environment Variables
# Copy this file to .env and update with your actual values

# Application Settings
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-here

# Database Configuration
DATABASE_URL=postgresql://guardian:guardian_password@localhost:5432/guardian_db
POSTGRES_DB=guardian_db
POSTGRES_USER=guardian
POSTGRES_PASSWORD=guardian_password

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# A2A Protocol Settings
A2A_BROKER_URL=redis://localhost:6379/1
A2A_API_TOKEN=your-a2a-api-token
A2A_SIGNATURE_SECRET=your-a2a-signature-secret

# Twilio Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+1234567890

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_REALTIME_API_KEY=your-openai-realtime-key

# SendGrid Configuration (Email)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=guardian@yourdomain.com
SENDGRID_FROM_NAME=Guardian Medical Tourism

# Firebase Configuration (Push Notifications)
FIREBASE_SERVER_KEY=your-firebase-server-key
FIREBASE_PROJECT_ID=your-firebase-project-id

# Flight Tracking APIs
AVIATION_STACK_API_KEY=your-aviation-stack-api-key
FLIGHTAWARE_API_KEY=your-flightaware-api-key
FLIGHTRADAR24_API_KEY=your-flightradar24-api-key

# AWS Configuration (for production deployment)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=guardian-medical-tourism
AWS_RDS_ENDPOINT=your-rds-endpoint

# Security Settings
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# HIPAA Compliance Settings
HIPAA_MODE=true
ENCRYPTION_KEY=your-encryption-key-32-chars-long
AUDIT_LOG_ENABLED=true
DATA_RETENTION_DAYS=2555  # 7 years for HIPAA compliance

# Voice Policy Settings
VOICE_POLICY_LEVEL=moderate
DEFAULT_CALL_LIMIT_DAILY=5
DEFAULT_CALL_LIMIT_HOURLY=2
EMERGENCY_OVERRIDE_ENABLED=true

# Notification Settings
SMS_ENABLED=true
EMAIL_ENABLED=true
PUSH_NOTIFICATIONS_ENABLED=true
WHATSAPP_ENABLED=true
NOTIFICATION_RETRY_ATTEMPTS=3

# Scheduler Settings
FLIGHT_MONITORING_INTERVAL_MINUTES=5
ETA_CHECK_INTERVAL_MINUTES=15
WORKFLOW_CLEANUP_HOUR=2
HEALTH_CHECK_INTERVAL_HOURS=1

# Monitoring and Logging
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=true
GRAFANA_PORT=3000
ELASTICSEARCH_URL=http://localhost:9200
LOGSTASH_URL=http://localhost:5044

# External Service URLs
HOTEL_API_BASE_URL=https://api.hotels.com/v1
HOSPITAL_API_BASE_URL=https://api.medical-centers.com/v1
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5
MAPS_API_BASE_URL=https://maps.googleapis.com/maps/api

# Development Settings
RELOAD_ON_CHANGE=true
ENABLE_DEBUG_ROUTES=true
MOCK_EXTERNAL_APIS=true
ENABLE_SWAGGER_UI=true

# Production Settings (override for production)
# ENVIRONMENT=production
# DEBUG=false
# MOCK_EXTERNAL_APIS=false
# ENABLE_DEBUG_ROUTES=false
