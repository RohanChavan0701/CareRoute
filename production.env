# Guardian A2A Orchestrator - Production Environment Configuration
# Copy this file to .env and update with your actual production values

# Application Settings
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=your-super-secret-production-key-change-this-now

# External Agent URLs (AWS Production Endpoints)
HOTEL_AGENT_URL=https://hotel-agent.your-domain.com/a2a/tasks
HOSPITAL_AGENT_URL=https://hospital-agent.your-domain.com/a2a/tasks
VOICE_AGENT_URL=https://voice-agent.your-domain.com/a2a/tasks
NOTIFICATION_AGENT_URL=https://notification-system-h36d.onrender.com/a2a/tasks
FLIGHT_AGENT_URL=http://54.158.27.0:8001/a2a

# LLM Integration (Optional - for intelligent responses)
OPENAI_API_KEY=your_openai_api_key_here

# Security Settings
JWT_SECRET_KEY=your-jwt-secret-key-32-chars-minimum
ENCRYPTION_KEY=your-encryption-key-exactly-32-chars-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# HIPAA Compliance Settings
HIPAA_MODE=true
AUDIT_LOG_ENABLED=true
DATA_RETENTION_DAYS=2555
ENCRYPTION_ENABLED=true

# Database Configuration (if using PostgreSQL)
POSTGRES_DB=guardian_production_db
POSTGRES_USER=guardian_prod_user
POSTGRES_PASSWORD=your-super-secure-postgres-password
DATABASE_URL=postgresql://guardian_prod_user:your-super-secure-postgres-password@localhost:5432/guardian_production_db

# Redis Configuration (if using Redis)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=your-redis-password

# Monitoring and Logging
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
HEALTH_CHECK_INTERVAL_HOURS=1
LOG_LEVEL=INFO

# Notification Settings
SMS_ENABLED=true
EMAIL_ENABLED=true
PUSH_NOTIFICATIONS_ENABLED=true
NOTIFICATION_RETRY_ATTEMPTS=3

# Scheduler Settings
FLIGHT_MONITORING_INTERVAL_MINUTES=5
ETA_CHECK_INTERVAL_MINUTES=15
WORKFLOW_CLEANUP_HOUR=2

# AWS Configuration (for EC2 deployment)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Production Settings
RELOAD_ON_CHANGE=false
ENABLE_DEBUG_ROUTES=false
MOCK_EXTERNAL_APIS=false
ENABLE_SWAGGER_UI=false

# Rate Limiting
API_RATE_LIMIT=100
AG_UI_RATE_LIMIT=50

# SSL/TLS Settings (if using HTTPS)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
